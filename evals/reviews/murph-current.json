  "ratings": {
    "composition": {
      "score": 3,
      "reason": "The object has a clear stage and the caption stays separate at desktop, 390px and 360px widths. Some assemblies still feel visually sparse.",
      "evidenceFiles": [
        "evals/reports/current/desktop.png",
        "evals/reports/current/mobile.png"
      ]
    },
    "typography": {
      "score": 3,
      "reason": "Consistent serif titles, quiet labels and restrained controls improve hierarchy. Narrow short screens use smaller body text and need physical-device review.",
      "evidenceFiles": [
        "evals/reports/current/desktop.png",
        "evals/reports/current/mobile.png"
      ]
    },
    "continuity": {
      "score": 2,
      "reason": "Physical separation and reversible inspection work, with no fades in the sampled run. Long transitions and changes in perceived scale still need a human scroll review.",
      "evidenceFiles": [
        "evals/reports/current/desktop.png",
        "evals/reports/current/mobile.png"
      ]
    },
    "pacing": {
      "score": 2,
      "reason": "Direct component selection now avoids forced repetition, but the full sixteen-turn tour is still long and many stops repeat similar motion.",
      "evidenceFiles": [
        "evals/reports/current/desktop.png",
        "evals/reports/current/mobile.png"
      ]
    },
    "controls": {
      "score": 3,
      "reason": "Component selector, next button, pause, free inspection and skip link are discoverable and keyboard operable; no usability study has been run.",
      "evidenceFiles": [
        "evals/reports/current/desktop.png",
        "evals/reports/current/mobile.png"
      ]
    },
    "accessibility": {
      "score": 3,
      "reason": "Reduced-motion users retain direct access to every modeled component and all seventeen written explanations. Automated viewport and keyboard checks pass; assistive-technology review remains outstanding.",
      "evidenceFiles": [
        "evals/reports/current/desktop.png",
        "evals/reports/current/mobile.png"
      ]
    },
    "identity": {
      "score": 2,
      "reason": "The object is recognizable, but generated dial numerals/ticks, exterior mesh waviness and simplified hand profiles prevent exact reference fidelity.",
      "evidenceFiles": [
        "evals/reports/current/component-review-20.png",
        "evals/reports/current/component-review-37.png",
        "evals/reports/current/component-review-50.png"
      ]
    },
    "anatomy": {
      "score": 1,
      "reason": "Sixteen independent groups exist, but the buckle is missing and hidden plate faces, interfaces and train layout are educational approximations.",
      "evidenceFiles": [
        "evals/reports/current/component-review-20.png",
        "evals/reports/current/component-review-37.png",
        "evals/reports/current/component-review-50.png"
      ]
    },
    "materials": {
      "score": 2,
      "reason": "Glass and authored metal use coherent scene lighting; exterior textures retain baked shading and the rotor still reads too uniform at some angles.",
      "evidenceFiles": [
        "evals/reports/current/component-review-20.png",
        "evals/reports/current/component-review-37.png",
        "evals/reports/current/component-review-50.png"
      ]
    },
    "optics": {
      "score": 2,
      "reason": "Both windows transmit and turn independently; some angles remain hard to read. Geometry profiles and rear composition are not established by measured manufacturer data.",
      "evidenceFiles": [
        "evals/reports/current/component-review-20.png",
        "evals/reports/current/component-review-37.png",
        "evals/reports/current/component-review-50.png"
      ]
    },
    "detail": {
      "score": 2,
      "reason": "Hand backs now have metal support and rotor markings avoid holes, but print accuracy, edge detail, back surfaces and actual manufacturing marks remain approximate.",
      "evidenceFiles": [
        "evals/reports/current/component-review-20.png",
        "evals/reports/current/component-review-37.png",
        "evals/reports/current/component-review-50.png"
      ]
    },
    "mechanism": {
      "score": 1,
      "reason": "The text traces energy, but gears are simplified and do not demonstrate correct meshing, escapement action or ratios. Separation is not a mechanism simulation.",
      "evidenceFiles": [
        "evals/reports/current/component-review-20.png",
        "evals/reports/current/component-review-37.png",
        "evals/reports/current/component-review-50.png"
      ]
    }
  },
