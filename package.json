{
  "name": "explode",
  "version": "0.1.0",
  "description": "Turn a photo of a physical object into a scroll-driven how-it's-made teardown.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "explode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dist-site",
    "public/spec.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:cli",
    "build:site": "vite build",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" && esbuild src/mcp.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/mcp.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/cli.js dist/mcp.js",
    "preview": "vite preview",
    "explode": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.105",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.157",
    "dotenv": "^18.0.9",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
