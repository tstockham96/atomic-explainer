# Building with a coding agent (Claude Code or similar) needs only the Tripo key.
# The agent does its own research and writing; run `npm run setup` once to install
# Blender and enter this key.
TRIPO_API_KEY=

# ── Standalone API pipeline only (no agent) ──────────────────────────────────
# `atomic-explainer ./photo.jpg` and the upload studio call models directly.
# Preferred: one key for every model, via Vercel AI Gateway.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# Used only when AI_GATEWAY_API_KEY is unset. Web-backed research always needs it.
OPENAI_API_KEY=
ATOMIC_EXPLAINER_WEB_RESEARCH_MODEL=gpt-4.1

# Gateway model ids look like provider/model.
# Direct OpenAI ignores the provider prefix.
ATOMIC_EXPLAINER_VISION_MODEL=google/gemini-2.5-flash
ATOMIC_EXPLAINER_RESEARCH_MODEL=anthropic/claude-sonnet-4.5
# Reference-image edit. Other options: bfl/flux-kontext-pro, bfl/flux-3-image, openai/gpt-image-1
ATOMIC_EXPLAINER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Image-to-video for the scroll film. gateway uses AI_GATEWAY_API_KEY.
# fal uses FAL_KEY and ATOMIC_EXPLAINER_VIDEO_PROVIDER=fal.
# Other gateway ids: google/veo-3.1-fast-generate-001, bytedance/seedance-v1.5-pro
ATOMIC_EXPLAINER_VIDEO_PROVIDER=gateway
ATOMIC_EXPLAINER_VIDEO_MODEL=klingai/kling-v2.6-i2v
FAL_KEY=

# Blender binary when it is not on PATH or in the standard install folder.
ATOMIC_EXPLAINER_BLENDER=
