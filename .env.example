# Preferred: one key for every model, via Vercel AI Gateway.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Used only when AI_GATEWAY_API_KEY is unset.
OPENAI_API_KEY=

# Gateway model ids look like provider/model.
# Direct OpenAI ignores the provider prefix.
EXPLODE_VISION_MODEL=google/gemini-2.5-flash
EXPLODE_RESEARCH_MODEL=anthropic/claude-sonnet-4.5
EXPLODE_IMAGE_MODEL=bfl/flux-2-pro
